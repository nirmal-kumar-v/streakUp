# StreakUp Environment Configuration
# Replace these placeholder values with your real configuration.

# PostgreSQL connection string
# Example format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/streakup?schema=public"

# Secret key for signing JWT authentication tokens
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Backend server port
PORT=5000

# Frontend URL (for CORS allowance)
CLIENT_URL="http://localhost:5173"

# StreakUp Backend Environment Configuration Template
# Replace with your PostgreSQL connection string:
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/streakup?schema=public"
JWT_SECRET="YOUR_SECRET_KEY_HERE"
PORT=5000
CLIENT_URL="http://localhost:5173"

# Email / SMTP configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=StreakUp

# Application URL used in email links (points to deployed frontend in production)
# In production on Render: APP_BASE_URL=https://streakup-karo.onrender.com
APP_BASE_URL=https://streakup-karo.onrender.com

# Secondary SMTP Account (for round-robin: rotates every 50 emails/day)
# Paste your 2nd Gmail account credentials below.
# If left empty, all emails will continue safely using the primary email above.
SMTP_HOST_2=smtp.gmail.com
SMTP_PORT_2=465
SMTP_SECURE_2=true
SMTP_USER_2=
SMTP_PASS_2=
MAIL_FROM_2=
MAIL_FROM_NAME_2=StreakUp



// StreakUp Prisma Schema for PostgreSQL
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Recurrence {
  DAILY
  ONE_TIME
}

enum TaskStatus {
  ACTIVE
  ARCHIVED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum FreezeScope {
  OVERALL
  TASK
}

enum EquivalenceStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
}

model User {
  id                      String           @id @default(uuid())
  name                    String
  username                String           @unique
  normalizedUsername      String           @unique // lowercased username for case-insensitive uniqueness
  email                   String           @unique
  passwordHash            String
  profileImage            String?
  timezone                String           @default("Asia/Kolkata")
  currentStreak           Int              @default(0)
  longestStreak           Int              @default(0)
  lastUsernameChangeAt    DateTime?
  overallFreezeBalance    Int              @default(0)
  overallFreezeRechargeDays Int            @default(0)
  lastOverallFreezeUsedAt DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  tasks                   Task[]
  taskCompletions         TaskCompletion[]
  sentFriendRequests      FriendRequest[]  @relation("SentFriendRequests")
  receivedFriendReqs      FriendRequest[]  @relation("ReceivedFriendRequests")
  friendshipsAsUser1      Friendship[]     @relation("User1Friendships")
  friendshipsAsUser2      Friendship[]     @relation("User2Friendships")
  freezeLogs              FreezeLog[]
  taskEquivalences        TaskEquivalence[]

  @@index([normalizedUsername])
  @@index([currentStreak(sort: Desc), longestStreak(sort: Desc)])
}

model Task {
  id                   String           @id @default(uuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  normalizedTitle      String?
  description          String?
  category             String           @default("General")
  priority             Priority         @default(MEDIUM)
  recurrence           Recurrence       @default(DAILY)
  dueTime              String?          // e.g. "18:00"
  status               TaskStatus       @default(ACTIVE)
  isCompleted          Boolean          @default(false) // completed flag for one-time tasks
  currentStreak        Int              @default(0)
  longestStreak        Int              @default(0)
  freezeBalance        Int              @default(0)
  freezeRechargeDays   Int              @default(0)
  lastFreezeUsedAt     DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  completions          TaskCompletion[]
  freezeLogs           FreezeLog[]
  equivalencesAsUserTask   TaskEquivalence[] @relation("UserTaskEquivalences")
  equivalencesAsFriendTask TaskEquivalence[] @relation("FriendTaskEquivalences")

  @@index([userId, status])
  @@index([userId, recurrence])
}

model TaskCompletion {
  id             String   @id @default(uuid())
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completionDate String   // Local calendar date in format "YYYY-MM-DD"
  studyNote      String?
  completedAt    DateTime @default(now())

  // Prevent duplicate completion records for the same task and local date
  @@unique([taskId, completionDate])
  @@index([userId, completionDate])
  @@index([taskId])
}

model FreezeLog {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId        String?
  task          Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  scope         FreezeScope
  scopeKey      String      // 'OVERALL' or 'TASK:<taskId>'
  protectedDate String      // Local date string "YYYY-MM-DD"
  usedAt        DateTime    @default(now())

  @@unique([userId, scopeKey, protectedDate])
  @@index([userId, scope])
  @@index([taskId])
  @@index([protectedDate])
}

model TaskEquivalence {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  friendId          String
  userTaskId        String
  userTask          Task              @relation("UserTaskEquivalences", fields: [userTaskId], references: [id], onDelete: Cascade)
  friendTaskId      String
  friendTask        Task              @relation("FriendTaskEquivalences", fields: [friendTaskId], references: [id], onDelete: Cascade)
  confidence        Float
  status            EquivalenceStatus @default(SUGGESTED)
  confirmedByUserId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([userId, userTaskId, friendTaskId])
  @@index([userId, status])
  @@index([friendId])
}

model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String
  sender     User                @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User                @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model Friendship {
  id        String   @id @default(uuid())
  user1Id   String
  user1     User     @relation("User1Friendships", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id   String
  user2     User     @relation("User2Friendships", fields: [user2Id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // user1Id < user2Id enforced by application logic ensures exactly 1 row per friendship
  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}


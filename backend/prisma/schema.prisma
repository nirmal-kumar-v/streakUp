// StreakUp Prisma Schema for PostgreSQL
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Recurrence {
  DAILY
  ONE_TIME
}

enum TaskStatus {
  ACTIVE
  ARCHIVED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum FreezeScope {
  OVERALL
  TASK
}

enum EquivalenceStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
}

enum NotificationCategory {
  OVERALL_REMINDER
  TASK_REMINDER
  FRIEND_OVERALL_ACTIVITY
  FRIEND_TASK_ACTIVITY
  FRIEND_OVERALL_MILESTONE
  FRIEND_TASK_MILESTONE
  MY_MILESTONE
  SYSTEM
  FRIEND_NUDGE
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum ReminderScope {
  OVERALL
  TASK
}

enum EmailDeliveryStatus {
  SENT
  FAILED
  PENDING
}

enum OtpPurpose {
  SIGNUP
  CHANGE_REGISTERED_EMAIL
  VERIFY_NOTIFICATION_EMAIL
  PASSWORD_RESET
}

model User {
  id                      String           @id @default(uuid())
  name                    String
  username                String           @unique
  normalizedUsername      String           @unique // lowercased username for case-insensitive uniqueness
  email                   String           @unique
  passwordHash            String
  profileImage            String?
  timezone                String           @default("Asia/Kolkata")
  currentStreak           Int              @default(0)
  longestStreak           Int              @default(0)
  points                  Int              @default(0)
  isEmailVerified         Boolean          @default(true) // Defaults to true so existing users remain verified
  lastUsernameChangeAt    DateTime?
  emailLastChangedAt      DateTime?        // Tracks last registered email change (14-day limit)
  overallFreezeBalance    Int              @default(0)
  overallFreezeRechargeDays Int            @default(0)
  lastOverallFreezeUsedAt DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  tasks                   Task[]
  taskCompletions         TaskCompletion[]
  sentFriendRequests      FriendRequest[]  @relation("SentFriendRequests")
  receivedFriendReqs      FriendRequest[]  @relation("ReceivedFriendRequests")
  friendshipsAsUser1      Friendship[]     @relation("User1Friendships")
  friendshipsAsUser2      Friendship[]     @relation("User2Friendships")
  freezeLogs              FreezeLog[]
  taskEquivalences        TaskEquivalence[]
  notifications           Notification[]
  friendNotifications     Notification[]   @relation("FriendNotifications")
  notificationPreference  NotificationPreference?
  reminderSchedules       ReminderSchedule[]
  milestoneEvents         MilestoneEvent[]
  emailDeliveries         EmailDelivery[]
  emailOtps               EmailOtp[]
  passwordResetTokens     PasswordResetToken[]
  pointLedgers            PointLedger[]
  ownedGroups             Group[]          @relation("OwnedGroups")
  groupMemberships        GroupMember[]
  noteReactions           StudyNoteReaction[]

  @@index([normalizedUsername])
  @@index([currentStreak(sort: Desc), longestStreak(sort: Desc)])
  @@index([points(sort: Desc)])
}

model Task {
  id                   String           @id @default(uuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  normalizedTitle      String?
  description          String?
  category             String           @default("General")
  priority             Priority         @default(MEDIUM)
  recurrence           Recurrence       @default(DAILY)
  scheduledDays        Int[]            @default([0, 1, 2, 3, 4, 5, 6]) // 0=Sun, 1=Mon, ..., 6=Sat
  dueTime              String?          // e.g. "18:00"
  status               TaskStatus       @default(ACTIVE)
  isCompleted          Boolean          @default(false) // completed flag for one-time tasks
  currentStreak        Int              @default(0)
  longestStreak        Int              @default(0)
  freezeBalance        Int              @default(0)
  freezeRechargeDays   Int              @default(0)
  lastFreezeUsedAt     DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  completions          TaskCompletion[]
  freezeLogs           FreezeLog[]
  equivalencesAsUserTask   TaskEquivalence[] @relation("UserTaskEquivalences")
  equivalencesAsFriendTask TaskEquivalence[] @relation("FriendTaskEquivalences")
  notifications        Notification[]
  reminderSchedules    ReminderSchedule[]
  pointLedgers         PointLedger[]

  @@index([userId, status])
  @@index([userId, recurrence])
}

model TaskCompletion {
  id             String   @id @default(uuid())
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completionDate String   // Local calendar date in format "YYYY-MM-DD"
  studyNote      String?
  completedAt    DateTime @default(now())

  reactions      StudyNoteReaction[]

  // Prevent duplicate completion records for the same task and local date
  @@unique([taskId, completionDate])
  @@index([userId, completionDate])
  @@index([taskId])
}

model FreezeLog {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId        String?
  task          Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  scope         FreezeScope
  scopeKey      String      // 'OVERALL' or 'TASK:<taskId>'
  protectedDate String      // Local date string "YYYY-MM-DD"
  usedAt        DateTime    @default(now())

  @@unique([userId, scopeKey, protectedDate])
  @@index([userId, scope])
  @@index([taskId])
  @@index([protectedDate])
}

model TaskEquivalence {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  friendId          String
  userTaskId        String
  userTask          Task              @relation("UserTaskEquivalences", fields: [userTaskId], references: [id], onDelete: Cascade)
  friendTaskId      String
  friendTask        Task              @relation("FriendTaskEquivalences", fields: [friendTaskId], references: [id], onDelete: Cascade)
  confidence        Float
  status            EquivalenceStatus @default(SUGGESTED)
  confirmedByUserId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([userId, userTaskId, friendTaskId])
  @@index([userId, status])
  @@index([friendId])
}

model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String
  sender     User                @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User                @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model Friendship {
  id        String   @id @default(uuid())
  user1Id   String
  user1     User     @relation("User1Friendships", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id   String
  user2     User     @relation("User2Friendships", fields: [user2Id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // user1Id < user2Id enforced by application logic ensures exactly 1 row per friendship
  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model Notification {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     NotificationCategory
  title        String
  message      String
  friendId     String?
  friend       User?                @relation("FriendNotifications", fields: [friendId], references: [id], onDelete: SetNull)
  taskId       String?
  task         Task?                @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actionUrl    String?
  isRead       Boolean              @default(false)
  readAt       DateTime?
  isDismissed  Boolean              @default(false)
  dismissedAt  DateTime?
  eventKey     String?              // Idempotency / deduplication key
  createdAt    DateTime             @default(now())

  @@index([userId, isDismissed, isRead, createdAt(sort: Desc)])
  @@index([userId, eventKey])
  @@index([friendId])
  @@index([taskId])
}

model NotificationPreference {
  id                          String   @id @default(uuid())
  userId                      String   @unique
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotificationsEnabled   Boolean  @default(true)
  inAppNotificationsEnabled   Boolean  @default(true)
  overallStreakRemindersEmail Boolean  @default(true)
  taskRemindersEmail          Boolean  @default(true)
  friendOverallActivityAlerts Boolean  @default(true)
  friendTaskActivityAlerts    Boolean  @default(true)
  friendOverallMilestones     Boolean  @default(true)
  friendTaskMilestones        Boolean  @default(true)
  myMilestonesEmail           Boolean  @default(true)
  freezeStatusNotifications   Boolean  @default(true)
  customNotificationEmail     String?
  isCustomEmailVerified       Boolean  @default(false)
  customEmailVerifyToken      String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model ReminderSchedule {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     ReminderScope @default(OVERALL)
  taskId    String?
  task      Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  time      String        // Format: "HH:mm" in 24hr format, e.g. "08:00", "14:00"
  isEnabled Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, scope, taskId, time])
  @@index([userId, isEnabled])
  @@index([scope, taskId])
}

model MilestoneEvent {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope      FreezeScope // OVERALL or TASK
  scopeKey   String      // 'OVERALL' or 'TASK:<taskId>'
  milestone  Int         // 5, 10, 25, 50, 100, 150...
  achievedAt DateTime    @default(now())

  @@unique([userId, scopeKey, milestone])
  @@index([userId, scope])
}

model EmailDelivery {
  id             String              @id @default(uuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientEmail String
  category       NotificationCategory
  subject        String
  idempotencyKey String              @unique
  status         EmailDeliveryStatus @default(PENDING)
  attemptCount   Int                 @default(1)
  lastAttemptAt  DateTime            @default(now())
  error          String?
  createdAt      DateTime            @default(now())

  @@index([userId, status])
  @@index([createdAt])
}

model EmailOtp {
  id         String     @id @default(uuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  otpHash    String     // SHA-256 hash of the 6-digit code
  purpose    OtpPurpose
  targetData String?    // Holds pending payload JSON (e.g. signup name/password or new email address)
  attempts   Int        @default(0)
  expiresAt  DateTime
  isUsed     Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([email, purpose, isUsed])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // SHA-256 hash of random reset token
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isUsed])
  @@index([expiresAt])
}

model PointLedger {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  points    Int      // +5 for completion, -5 for missed scheduled habit
  reason    String   // 'COMPLETION' or 'MISSED_SCHEDULED'
  date      String   // Local calendar date "YYYY-MM-DD"
  createdAt DateTime @default(now())

  @@unique([userId, taskId, date, reason])
  @@index([userId, date])
  @@index([userId, points])
}

model StudyNoteReaction {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  completionId String
  completion   TaskCompletion @relation(fields: [completionId], references: [id], onDelete: Cascade)
  emoji        String         // 'FIRE', 'STRONG', 'CLAP', 'CELEBRATE'
  createdAt    DateTime       @default(now())

  @@unique([userId, completionId, emoji])
  @@index([completionId])
  @@index([userId])
}

model Group {
  id          String        @id @default(uuid())
  name        String
  description String?
  joinCode    String        @unique
  ownerId     String
  owner       User          @relation("OwnedGroups", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     GroupMember[]

  @@index([joinCode])
  @@index([ownerId])
}

model GroupMember {
  id       String    @id @default(uuid())
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}



